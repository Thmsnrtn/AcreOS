{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "build:analyze": "ANALYZE=1 tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "tsc --noEmit && npm run lint:schema",
    "lint:schema": "node scripts/check-org-leading-index.mjs",
    "lint:voice": "node scripts/voice-lint.mjs",
    "lint": "eslint client/src --max-warnings 0",
    "lint:fix": "eslint client/src --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:mobile": "playwright test --config=playwright.mobile.config.ts",
    "test:e2e:full": "playwright test --config=playwright.full.config.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "audit:security": "npm audit --audit-level=high",
    "test:security": "vitest run tests/unit/securityTests.test.ts tests/unit/promptInjection.test.ts tests/unit/fieldEncryptionMiddleware.test.ts tests/unit/securityHeaders.test.ts tests/unit/piiMasking.test.ts",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:simulation": "vitest run tests/simulation/sim-load-profile.spec.ts tests/simulation/chaos.spec.ts",
    "test:chaos": "vitest run tests/simulation/chaos.spec.ts",
    "test:scale": "playwright test tests/simulation/sim-scaling-operator.spec.ts",
    "test:a11y": "vitest run tests/unit/accessibility.test.ts",
    "test:bundle-size": "node scripts/check-bundle-size.js",
    "typecheck": "tsc --noEmit",
    "verify:registry": "node scripts/verify-registry.js",
    "verify:clean-deploy": "npm run build && echo 'Build verified'",
    "eval": "tsx evals/run-eval.ts",
    "eval:smoke": "tsx evals/run-eval.ts --limit 5",
    "eval:gate": "node scripts/eval-gate.mjs",
    "cmo:generate-script": "tsx scripts/cmo-generate-script.ts",
    "cmo:seed": "tsx scripts/cmo-seed.ts",
    "truth-engine:audit": "tsx scripts/audit-public-claims.ts",
    "truth-engine:audit-learn": "tsx scripts/audit-learn-pages.ts",
    "cmo:render-ad": "tsx scripts/cmo-render-ad.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:run:ios": "npx cap run ios --livereload --external",
    "cap:run:android": "npx cap run android --livereload --external",
    "mobile:ios:dev": "npm run build && npx cap copy ios && npx cap open ios",
    "mobile:android:dev": "npm run build && npx cap copy android && npx cap open android",
    "mobile:ios:build": "npm run build && npx cap copy ios && cd ios/App && xcodebuild -workspace App.xcworkspace -scheme App -configuration Debug -sdk iphonesimulator -derivedDataPath build clean build",
    "mobile:android:build": "npm run build && npx cap copy android && cd android && ./gradlew assembleDebug"
  },
