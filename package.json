{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "build:analyze": "ANALYZE=1 tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "test": "vitest run",
    "verify-receipt": "node scripts/verify-receipt.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:build-from-repo": "bash scripts/ci/build-schema-from-repo.sh",
    "check": "npm run check:app && npm run check:tests && npm run lint:schema && npm run lint:schema-migrate-mirror && npm run lint:ledger-refs && npm run lint:no-fabrication && npm run lint:ghost-fields && npm run lint:measurement-defaults && npm run lint:boundaries && npm run lint:kernel-boundary && npm run lint:ratchets && npm run lint:reachability && npm run lint:model-prefix && npm run lint:prompt-envelope && npm run lint:contract-adoption && npm run lint:org-fetch && npm run lint:css-hover && npm run lint:page-hex && npm run lint:dead-token-alpha && npm run lint:semantic-contrast && npm run lint:unchecked-mutation && npm run lint:prefetch-authority && npm run lint:date-format && npm run lint:zindex && npm run lint:translucency && npm run lint:eslint-ratchet && npm run lint:browser-safe-shared && npm run lint:route-order && npm run lint:route-shadowing && npm run lint:infrastructure-restraint && npm run lint:residential-comps-hold && npm run lint:inline-provenance",
    "lint:browser-safe-shared": "node scripts/check-browser-safe-shared.mjs",
    "lint:infrastructure-restraint": "node scripts/check-infrastructure-restraint.mjs",
    "lint:residential-comps-hold": "node scripts/check-residential-comps-hold.mjs",
    "lint:route-order": "node scripts/check-route-order.mjs",
    "lint:route-shadowing": "node scripts/check-route-shadowing.mjs",
    "lint:eslint-ratchet": "node scripts/lint-eslint-ratchet.mjs",
    "lint:no-fabrication": "node scripts/check-no-fabrication.mjs",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "lint:kernel-boundary": "node scripts/check-kernel-boundary.mjs",
    "lint:ratchets": "node scripts/ratchet.mjs",
    "check:app": "NODE_OPTIONS=--max-old-space-size=6144 tsc --noEmit --incremental false",
    "check:tests": "node scripts/check-tests-typecheck.mjs",
    "lint:reachability": "node scripts/lint-reachability.mjs",
    "lint:contract-adoption": "node scripts/check-contract-adoption.mjs",
    "lint:schema": "node scripts/check-org-leading-index.mjs",
    "lint:schema-migrate-mirror": "node scripts/check-schema-migrate-mirror.mjs",
    "lint:ledger-refs": "node scripts/check-ledger-refs.mjs",
    "lint:org-fetch": "node scripts/check-org-scoped-fetch.mjs",
    "lint:css-hover": "node scripts/lint-css-hover.mjs",
    "lint:page-hex": "node scripts/lint-page-hex.mjs",
    "lint:dead-token-alpha": "node scripts/lint-dead-token-alpha.mjs",
    "lint:semantic-contrast": "node scripts/lint-semantic-contrast.mjs",
    "lint:unchecked-mutation": "node scripts/lint-unchecked-mutation.mjs",
    "lint:prefetch-authority": "node scripts/lint-prefetch-authority.mjs",
    "lint:date-format": "node scripts/lint-date-format.mjs",
    "lint:zindex": "node scripts/lint-zindex.mjs",
    "lint:translucency": "node scripts/lint-translucency.mjs",
    "lint:voice": "node scripts/voice-lint.mjs",
    "lint": "eslint client/src --max-warnings 0",
    "lint:fix": "eslint client/src --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:mobile": "playwright test --config=playwright.mobile.config.ts",
    "test:e2e:full": "playwright test --config=playwright.full.config.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "audit:security": "npm audit --audit-level=high",
    "test:security": "vitest run tests/unit/securityTests.test.ts tests/unit/promptInjection.test.ts tests/unit/fieldEncryptionMiddleware.test.ts tests/unit/securityHeaders.test.ts tests/unit/piiMasking.test.ts",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:simulation": "vitest run tests/simulation/sim-load-profile.spec.ts tests/simulation/chaos.spec.ts",
    "test:chaos": "vitest run tests/simulation/chaos.spec.ts",
    "test:scale": "playwright test tests/simulation/sim-scaling-operator.spec.ts",
    "test:a11y": "vitest run tests/unit/accessibility.test.ts",
    "test:bundle-size": "node scripts/check-bundle-size.js",
    "typecheck": "tsc --noEmit",
    "verify:registry": "node scripts/verify-registry.js",
    "verify:clean-deploy": "npm run build && echo 'Build verified'",
    "eval": "tsx evals/run-eval.ts",
    "eval:smoke": "tsx evals/run-eval.ts --limit 5",
    "eval:gate": "node scripts/eval-gate.mjs",
    "cmo:generate-script": "tsx scripts/cmo-generate-script.ts",
    "cmo:seed": "tsx scripts/cmo-seed.ts",
    "truth-engine:audit": "tsx scripts/audit-public-claims.ts",
    "truth-engine:audit-learn": "tsx scripts/audit-learn-pages.ts",
    "cmo:render-ad": "tsx scripts/cmo-render-ad.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:run:ios": "npx cap run ios --livereload --external",
    "cap:run:android": "npx cap run android --livereload --external",
    "mobile:ios:dev": "npm run build && npx cap copy ios && npx cap open ios",
    "mobile:android:dev": "npm run build && npx cap copy android && npx cap open android",
    "mobile:ios:build": "npm run build && npx cap copy ios && cd ios/App && xcodebuild -workspace App.xcworkspace -scheme App -configuration Debug -sdk iphonesimulator -derivedDataPath build clean build",
    "mobile:android:build": "npm run build && npx cap copy android && cd android && ./gradlew assembleDebug",
    "lint:prompt-envelope": "node scripts/lint-prompt-envelope.mjs",
    "lint:measurement-defaults": "node scripts/check-measurement-defaults.mjs",
    "lint:model-prefix": "node scripts/check-model-prefix.mjs",
    "lint:ghost-fields": "NODE_OPTIONS=--max-old-space-size=6144 node scripts/check-ghost-fields.mjs",
    "lint:inline-provenance": "node scripts/check-inline-provenance.mjs"
  },
