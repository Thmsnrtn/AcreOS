# Required secrets for Fly.io deployment
# Set via: fly secrets set KEY=value
# For multiple: fly secrets set KEY1=value1 KEY2=value2

# ── Core ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://...
SESSION_SECRET=<min 32 chars, 64+ recommended — generate with: openssl rand -base64 48>
APP_URL=https://your-app.fly.dev
REDIS_URL=redis://...

# ── Google OAuth (optional — leave unset to disable) ─────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Founder / Admin ──────────────────────────────────────────
FOUNDER_EMAIL=founder@yourdomain.com

# ── Field Encryption (required in production) ────────────────
# AES-256 key — exactly 64 hex chars (32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=<64-hex-chars>

# ── AI — OpenRouter / OpenAI ────────────────────────────────
# Primary AI provider (routes to Claude, GPT-4o, DeepSeek)
AI_INTEGRATIONS_OPENROUTER_API_KEY=sk-or-...
# Fallback / legacy OpenAI keys (optional)
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email — AWS SES ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=no-reply@yourdomain.com

# ── SendGrid Event Webhook — Ed25519 signature verification ──
# Public key emitted by SendGrid Mail Settings → Event Webhook → Signed
# Event Webhook. Base64 (DER) or PEM both accepted.
# Required to enable POST /api/webhooks/sendgrid/events. If unset, the
# endpoint returns 503 (closed by default — no fall-through accept).
# SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=<base64-or-pem-ed25519-pubkey>

# ── Twilio (Voice / SMS) — optional ─────────────────────────
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...

# ── Telnyx (alternative VoIP) — optional ────────────────────
# TELNYX_API_KEY=KEY...
# TELNYX_PHONE_NUMBER=+1...

# ── Mapbox (client-side maps) ───────────────────────────────
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ1...

# ── Lob (direct mail) — optional ────────────────────────────
# LOB_API_KEY=test_...

# ── MCP / Security ──────────────────────────────────────────
MCP_API_KEY=<secure-random-string>

# ── Error Tracking — Sentry (optional) ──────────────────────
# SENTRY_DSN=https://...@sentry.io/...
