{
  "statuses": [
    "not_started",
    "pending",
    "approved",
    "failed"
  ],
  "sourceLabels": {
    "provider_api": "Read from your provider",
    "self_reported": "Self-reported — you told us; AcreOS has not verified it with your provider"
  },
  "steps": [
    {
      "id": "business_profile",
      "title": "Business profile (your provider's customer profile)",
      "why": "Carriers register the BUSINESS sending the texts — yours, under its legal name and tax ID.",
      "fields": [
        {
          "attribute": "business_name",
          "label": "Legal business name (exactly as on your EIN letter)",
          "required": "yes"
        },
        {
          "attribute": "business_type",
          "label": "Business type (sole proprietorship, partnership, corporation, LLC, co-operative, non-profit)",
          "required": "yes"
        },
        {
          "attribute": "business_industry",
          "label": "Industry (real estate)",
          "required": "yes"
        },
        {
          "attribute": "business_registration_identifier",
          "label": "Registration ID type (EIN for a US business)",
          "required": "yes"
        },
        {
          "attribute": "business_registration_number",
          "label": "EIN",
          "required": "yes"
        },
        {
          "attribute": "website_url",
          "label": "Business website",
          "required": "yes",
          "note": "Carriers check it matches the business; it should show your opt-in and privacy policy."
        },
        {
          "attribute": "social_media_profile_urls",
          "label": "Social profiles",
          "required": "optional"
        },
        {
          "attribute": "business_regions_of_operation",
          "label": "Regions of operation (USA and Canada)",
          "required": "yes"
        },
        {
          "attribute": "business_identity",
          "label": "Business identity (direct customer)",
          "required": "yes"
        },
        {
          "attribute": "street / city / region / postal_code / iso_country",
          "label": "Business address",
          "required": "yes"
        }
      ]
    },
    {
      "id": "authorized_representative",
      "title": "Authorized representative",
      "why": "A person at the business the carriers can hold responsible.",
      "fields": [
        {
          "attribute": "first_name",
          "label": "First name",
          "required": "yes"
        },
        {
          "attribute": "last_name",
          "label": "Last name",
          "required": "yes"
        },
        {
          "attribute": "business_title",
          "label": "Title",
          "required": "yes"
        },
        {
          "attribute": "job_position",
          "label": "Job position (Director, GM, VP, CEO, CFO, General Counsel, Other)",
          "required": "yes"
        },
        {
          "attribute": "phone_number",
          "label": "Phone",
          "required": "yes"
        },
        {
          "attribute": "email",
          "label": "Email",
          "required": "yes"
        }
      ]
    },
    {
      "id": "brand",
      "title": "Brand registration",
      "why": "The brand is your business as The Campaign Registry knows it. Approval usually takes days, sometimes weeks.",
      "fields": [
        {
          "attribute": "company_type",
          "label": "Company type (private, public, non-profit, government)",
          "required": "yes"
        },
        {
          "attribute": "stock_exchange",
          "label": "Stock exchange",
          "required": "if_applicable",
          "note": "Public companies only."
        },
        {
          "attribute": "stock_ticker",
          "label": "Stock ticker",
          "required": "if_applicable",
          "note": "Public companies only."
        },
        {
          "attribute": "brand_contact_email",
          "label": "Brand contact email (receives a verification code)",
          "required": "yes"
        },
        {
          "attribute": "skip_automatic_sec_vet",
          "label": "Skip secondary vetting",
          "required": "optional",
          "note": "Only for Low-Volume Standard brands."
        }
      ]
    },
    {
      "id": "campaign",
      "title": "Campaign registration",
      "why": "The campaign says what you text, to whom, and how they agreed to it. It needs a Messaging Service with your 10DLC number in its sender pool.",
      "fields": [
        {
          "attribute": "us_app_to_person_usecase",
          "label": "Use case (e.g. MIXED or MARKETING for seller outreach)",
          "required": "yes"
        },
        {
          "attribute": "description",
          "label": "Campaign description (40–4096 characters)",
          "required": "yes"
        },
        {
          "attribute": "message_flow",
          "label": "How people opt in (40–2048 characters) — e.g. the web form or reply that gives consent",
          "required": "yes"
        },
        {
          "attribute": "message_samples",
          "label": "2–5 sample messages (20–1024 characters each), with opt-out language",
          "required": "yes"
        },
        {
          "attribute": "has_embedded_links",
          "label": "Messages contain links?",
          "required": "yes"
        },
        {
          "attribute": "has_embedded_phone",
          "label": "Messages contain phone numbers?",
          "required": "yes"
        },
        {
          "attribute": "opt_in_message / opt_in_keywords",
          "label": "Opt-in reply and keywords",
          "required": "if_applicable",
          "note": "Only if people can text a keyword to opt in."
        },
        {
          "attribute": "opt_out_message / opt_out_keywords",
          "label": "Opt-out reply and keywords (STOP)",
          "required": "if_applicable",
          "note": "Only if you manage opt-outs yourself instead of the provider's defaults."
        },
        {
          "attribute": "help_message / help_keywords",
          "label": "Help reply and keywords (HELP)",
          "required": "if_applicable",
          "note": "Same rule as opt-out."
        }
      ]
    }
  ]
}
