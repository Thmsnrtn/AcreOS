#!/bin/sh
# Pre-commit hook: type-check only
# ESLint and Prettier checks disabled until config is migrated to flat config

set -e

echo "Running pre-commit checks..."

# 1. TypeScript type-check
echo "→ Type checking..."
npx tsc --noEmit || {
  echo "✗ TypeScript errors found. Fix before committing."
  exit 1
}

echo "✓ All pre-commit checks passed."
