    "http://localhost:5000/deals",
    "http://localhost:5000/properties",
    "http://localhost:5000/today",
    "http://localhost:5000/pricing",
    "http://localhost:5000/login",
    "http://localhost:5000/settings",
    "http://localhost:5000/parcels"
  ]
}
