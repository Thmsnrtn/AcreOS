tests/e2e-desktop-feel/results/
tests/e2e-mobile/results/
test-results/

# Dev founder bypass artifacts (REMOVE_BEFORE_LAUNCH — see Gap 1.1.G)
# .env.local already gitignored above; .log already gitignored above.
# Explicit entry for the local secret file:
.dev-bypass-secret

# Variant picker (REMOVE_BEFORE_LAUNCH — Gap 1.1.G)
# dist/ is committed so the picker is served from acreos.fly.dev with no
# extra build step — same-origin hosting is required for picker iframes
# to carry Clerk session cookies. The leading `dist` rule above would
# normally exclude it; explicitly negate.
acreos-picker/node_modules/
!acreos-picker/dist/
!acreos-picker/dist/**

# 1.1.D resume handoff doc (REMOVE_BEFORE_LAUNCH — Gap 1.1.G; gets
# committed intentionally so a fresh session can pick up where the
# previous one left off)
!docs/exhaustive-completion/_RESUME-*.md

# Eval harness reports (generated locally; CI uploads as artifacts)
evals/reports/


# Audit screenshots from Playwright walkthroughs (local only, not for repo)
audit-*.png
walk-*.png
w2-*.png
persona-prod-parcelcheck-desktop.png
.playwright-mcp/

# Gate self-test fixtures. `measurementDefaultsGate.test.ts` and
# `orgScopedFetchCoverage.test.ts` write these into the real tree, run the real
# gate against them, and delete them again — that is how each gate proves it
# still FIRES rather than only that it passes. An interrupted run leaves one
# behind, and one was committed by accident on 2026-08-19, which broke both
# gates' "passes on the current tree" case. They are never source.
server/services/__measurement_probe__.ts
server/services/__rule3_canary__.ts
