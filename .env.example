# ============================================================
# AcreOS — Environment Variables Reference
# Copy this file to .env and fill in your values.
# Never commit your .env file to source control.
# ============================================================

# ── Core ────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/acreos

# Secure random string — REQUIRED, minimum 32 characters, 64+ recommended
# Generate with: openssl rand -base64 48
# The server will refuse to start in production if this is shorter than 32 chars.
SESSION_SECRET=replace-with-a-long-random-string

# Public URL of the deployed app (no trailing slash) — REQUIRED in production
APP_URL=https://yourdomain.com
# Public URL alias used by some client-facing services
PUBLIC_APP_URL=https://yourdomain.com

# Port the Node server listens on (default: 5000)
PORT=5000

# Node environment (development | production | test)
NODE_ENV=development

# ── Google OAuth ────────────────────────────────────────────
# Required for "Continue with Google" sign-in on the auth page.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Set the Authorized redirect URI to: ${APP_URL}/api/auth/google/callback
# Leave blank to disable Google OAuth (email/password still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Founder / Admin ─────────────────────────────────────────
# Email address that grants founder-level admin access
# Also receives in-app feedback notification emails (POST /api/feedback)
FOUNDER_EMAIL=founder@yourdomain.com
# Additional comma-separated founder emails (getOrCreateOrg reads both FOUNDER_EMAIL and FOUNDER_EMAILS)
FOUNDER_EMAILS=
# Comma-separated user IDs that also get founder-level access (optional override)
FOUNDER_USER_IDS=

# ── AI — OpenRouter (primary platform provider) ─────────────
# All platform AI features route through OpenRouter.
# Get your key at https://openrouter.ai/keys
AI_INTEGRATIONS_OPENROUTER_API_KEY=sk-or-...
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── AI — OpenAI Direct (optional, user-provided) ────────────
# Only needed if a user wants to bring their own OpenAI key.
# Platform does NOT require this — OpenRouter handles all models.
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ── Email — AWS SES ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
# Region for SES if different from AWS_REGION
AWS_SES_REGION=us-east-1
# Verified SES sender address
AWS_SES_FROM_EMAIL=no-reply@yourdomain.com
# Alias used by some services
SES_FROM_EMAIL=no-reply@yourdomain.com
# Display name shown in From header
AWS_SES_FROM_NAME=AcreOS

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Webhook signing secret from Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Twilio (Voice / SMS) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ── Telnyx (alternative VoIP) ────────────────────────────────
TELNYX_API_KEY=KEY...
TELNYX_PHONE_NUMBER=+1...

# ── Map renderer (client-side) ───────────────────────────────
# Rosy River B1 — the app supports two map engines:
#
#   VITE_MAP_ENGINE=mapbox    (default) Uses mapbox-gl + Mapbox vector
#                             styles. Requires VITE_MAPBOX_ACCESS_TOKEN.
#                             Cost: per-tile pricing after free tier.
#
#   VITE_MAP_ENGINE=maplibre  Uses maplibre-gl + Stadia open-source
#                             vector tiles. No token strictly required
#                             but VITE_STADIA_API_KEY recommended at
#                             scale (free tier rate-limits after ~10k
#                             tiles/day). Get a key at stadiamaps.com.
#
# Phase 2 of the migration swaps the renderer in property-map.tsx; until
# then mapbox remains the default and maplibre-gl ships as a parallel
# dependency for staged testing. See client/src/lib/map-engine.ts.
# VITE_MAP_ENGINE=mapbox

# ── Mapbox (client-side maps) ────────────────────────────────
# Exposed to the Vite/React client — safe for public tokens
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ1...
# Server-side alias
MAPBOX_PUBLIC_TOKEN=pk.eyJ1...

# ── Stadia (open-source map tiles, MapLibre path) ────────────
# Optional but recommended for production. Free tier covers ~10k
# tiles/day without a key; with a key the cap moves to 1M/month.
# Register at https://stadiamaps.com/.
# VITE_STADIA_API_KEY=...

# ── Lob (direct mail) ────────────────────────────────────────
LOB_API_KEY=test_...
# LOB_LIVE_API_KEY=live_...
# LOB_TEST_API_KEY=test_...
# Live-send interlock: the live key is ONLY used when NODE_ENV=production
# AND this is exactly "true". Until then every platform-keyed send runs in
# Lob's test environment — no physical mail. Flip at launch, never in dev.
# LOB_LIVE_SEND_ENABLED=true

# ── HelloSign / Dropbox Sign (e-signatures) ──────────────────
# HELLOSIGN_API_KEY=...
# DROPBOX_SIGN_API_KEY=...

# ── Regrid (parcel data) ─────────────────────────────────────
# REGRID_API_KEY=...

# ── RapidAPI (data enrichment) ───────────────────────────────
# RAPIDAPI_KEY=...

# ── QuickBooks Online ────────────────────────────────────────
# QBO_CLIENT_ID=...
# QBO_REDIRECT_URI=https://yourdomain.com/api/qbo/callback
# QBO_SANDBOX=true

# ── Meta Ads ─────────────────────────────────────────────────
# META_ACCESS_TOKEN=...
# META_AD_ACCOUNT_ID=act_...
# META_PAGE_ID=...
# META_PIXEL_ID=...
# META_CATALOG_ID=...
# META_APP_URL=https://yourdomain.com
# META_WEBHOOK_VERIFY_TOKEN=...

# ── Land Marketplace Integrations ────────────────────────────
# LANDFLIP_API_KEY=...
# LANDFLIP_MEMBER_ID=...
# LANDCOM_API_KEY=...
# LANDCOM_BROKER_ID=...

# ── Payment Processing — Actum ───────────────────────────────
# ACTUM_API_KEY=...
# ACTUM_MERCHANT_ID=...
# ACTUM_ENDPOINT=https://...

# ── USPS Address Verification ────────────────────────────────
# USPS_USER_ID=...

# ── PCM (direct mail alternative) ───────────────────────────
# PCM_API_KEY=...

# ── Compliance ───────────────────────────────────────────────
# Compliance enforcement mode. When "true", blocks operations that violate
# usury laws or Dodd-Frank regulations. When "false" (default), logs warnings
# but allows operations to proceed.
# COMPLIANCE_STRICT_MODE=true

# ── Security / MCP ───────────────────────────────────────────
# API key required to access the MCP endpoint (StreamableHTTP)
MCP_API_KEY=replace-with-a-secure-random-string
# T0-3 (2026-06-10): org the static MCP_API_KEY is bound to. Org-scoped MCP
# tools (search_properties, get_property, search_leads, get_deals,
# get_portfolio_summary) only serve THIS org; unset → public-data tools only.
# Per-org api keys (ak_live_…) bind to their own org and ignore this.
# MCP_ORG_ID=1
# Internal MCP key (alternative name used in some services)
INTERNAL_MCP_KEY=replace-with-a-secure-random-string

# Encryption key for sensitive stored values (32-byte hex or base64)
# ENCRYPTION_KEY=...

# AES-256 field-level encryption key — required in production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Used to encrypt PII fields at rest.
# FIELD_ENCRYPTION_KEY=<64-hex-chars>

# ── Error Tracking — Sentry ──────────────────────────────────
# Server-side DSN (Node/Express) — add to enable production error tracking
# SENTRY_DSN=https://...@sentry.io/...
# Client-side DSN (React) — exposed to browser, use project's browser DSN
# VITE_SENTRY_DSN=https://...@sentry.io/...
# Fraction of transactions to sample for performance monitoring (0.0–1.0)
# SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Source map upload (CI only — store in GitHub Secrets, never in .env)
# SENTRY_AUTH_TOKEN=sntrys_...   (Settings → Auth Tokens → Create Token → project:releases scope)
# SENTRY_ORG=your-sentry-org-slug
# SENTRY_PROJECT=acreos

# ── Redis (required after BullMQ job queue migration) ────────
REDIS_URL=redis://localhost:6379

# ── Multitenancy ─────────────────────────────────────────────
# Override the default organization ID for seeding/testing
# DEFAULT_ORG_ID=1

# ── Web Push Notifications (VAPID) ───────────────────────────
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── Clerk Authentication ───────────────────────────────────────
# Both keys are REQUIRED — get them from https://dashboard.clerk.com
# Server-side secret key (used by @clerk/express to validate JWTs)
CLERK_SECRET_KEY=sk_live_...
# Client-side publishable key (used by @clerk/react ClerkProvider)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
# Server also reads the publishable key for clerkMiddleware — set both:
CLERK_PUBLISHABLE_KEY=pk_live_...

# ── R4: Clerk MFA Enforcement ──────────────────────────────────
# When set to "true" (or "1"), every authenticated user without 2FA
# enabled in Clerk gets a 403 mfa_setup_required from /api/admin/*.
# When false/unset, only high-trust paths (admin recovery, ownership
# transfer) require 2FA. See server/middleware/requireClerkMFA.ts.
# MFA_REQUIRED_FOR_ALL_USERS=false

# ── Microsoft OAuth ────────────────────────────────────────────
# Required for "Continue with Microsoft" sign-in
# MICROSOFT_CLIENT_ID=...
# MICROSOFT_CLIENT_SECRET=...
# MICROSOFT_TENANT_ID=...

# ── AI — Anthropic (Claude) ────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── AI — OpenRouter (duplicate — see primary section above) ──
# Already configured above. This section kept for reference only.

# ── AI — Budget & Rate Limits ──────────────────────────────────
# AI_DAILY_BUDGET_CENTS=5000
# AI_HOURLY_BUDGET_CENTS=500
# AI_WEEKLY_BUDGET_CENTS=20000
# AI_COST_THROTTLE_PCT=80
# AI_USER_DAILY_LIMIT_USD=10
# AI_USER_MONTHLY_LIMIT_USD=200

# ── Deepgram (speech-to-text) ──────────────────────────────────
# DEEPGRAM_API_KEY=...

# ── Autonomous Decision Engine ─────────────────────────────────
# AUTONOMOUS_EXECUTOR_ENABLED=false
# AUTONOMOUS_CONFIDENCE_THRESHOLD=0.85
# AUTONOMOUS_MAX_FINANCIAL_IMPACT=50000
# AUTONOMOUS_HARD_STOP_TYPES=billing,subscription,data_deletion

# ── Database Replicas ──────────────────────────────────────────
# Read-replica connection string for read-heavy queries
# DATABASE_REPLICA_URL=postgresql://user:password@replica:5432/acreos
# DB_REPLICA_POOL_MAX=10
# S3 bucket for automated DB backups
# DB_BACKUP_S3_BUCKET=acreos-db-backups

# ── Data Enrichment APIs ───────────────────────────────────────
# ATTOM (property details, valuations, comps)
# ATTOM_API_KEY=...
# BatchData (property lookup, skip tracing)
# BATCHDATA_API_KEY=...
# Census Bureau
# CENSUS_API_KEY=...
# County assessor data
# COUNTY_API_KEY=...
# PropStream
# PROPSTREAM_API_KEY=...
# PROPSTREAM_EMAIL=...
# PROPSTREAM_PASSWORD=...
# Socrata (open data portals)
# SOCRATA_APP_TOKEN=...
# USDA NASS (agricultural data)
# USDA_NASS_API_KEY=...
# FCC Broadband Data Collection (broadband availability). Free token from an
# FCC account (https://broadbandmap.fcc.gov/data-download → API access).
# Unkeyed, broadband lookups honestly report "unavailable" — never guessed.
# FCC_BDC_USERNAME is the FCC account email the token belongs to (optional
# header per the BDC public data API spec).
# FCC_BDC_TOKEN=...
# FCC_BDC_USERNAME=...
# NREL (energy data)
# NREL_API_KEY=...
# Zoneomics (zoning data)
# ZONEOMICS_API_KEY=...
# News API
# NEWS_API_KEY=...
# REI Skip (skip tracing)
# REISKIP_API_KEY=...
# Batch skip tracing
# BATCH_SKIP_TRACING_API_KEY=...

# ── SendGrid (transactional email) ─────────────────────────────
# SENDGRID_FROM_EMAIL=no-reply@yourdomain.com

# ── Communications ─────────────────────────────────────────────
# CALL_DISCLOSURE_TEXT=This call may be recorded for quality purposes.
# COMM_DEDUP_TTL_HOURS=24
# GROWTH_EMAIL_COOLDOWN_DAYS=7

# ── Observability — OpenTelemetry ──────────────────────────────
# OTEL_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_AUTO_INDEX=true
# METRICS_TOKEN=...

# ── Health Monitoring ──────────────────────────────────────────
# HEALTH_JOB_FAILURE_THRESHOLD=3
# HEALTH_JOB_FAILURE_WINDOW_HOURS=1
# HEALTH_NOTIFY_FOUNDER=true

# ── WebSocket ──────────────────────────────────────────────────
# MAX_WS_CONNECTIONS=1000

# ── Idempotency ────────────────────────────────────────────────
# IDEMPOTENCY_TTL_HOURS=24

# ── Phase 0 traffic-readiness hardening ────────────────────────
# Bot-signal collection runs unconditionally — these flags only
# toggle the optional CAPTCHA gate on signup.
# ENABLE_CAPTCHA=1
# CAPTCHA_PROVIDER=hcaptcha   # or 'turnstile'
# CAPTCHA_SECRET_KEY=...

# OFAC SDN sanctions list ingestion (daily cron). The default
# Treasury endpoint is hard-coded; override if mirroring locally.
# OFAC_SDN_URL=https://www.treasury.gov/ofac/downloads/sdn.csv
# OFAC_REFRESH_HOURS=24

# ── DNC / litigator scrub (TCPA cold-outreach seam) ────────────
# INERT until a vendor is chosen (roadmap-2026-07 Founder decision #1).
# Setting a provider arms the gate inside sendOrgSMS: litigator numbers
# block even with consent; DNC-listed numbers block without express
# consent. "fixture" is the deterministic test adapter — never use in prod.
# DNC_SCRUB_PROVIDER=none
# DNC_SCRUB_TTL_DAYS=30

# ── Open-data corpora object storage (Tier-2 bulk ownership) ───
# Founder ruling 2026-07-28 #10: own the public-domain corpora
# (NAIP aerial, 3DEP terrain/lidar, statewide parcels, NLCD, CDL,
# PLSS, TIGER, NAD addresses, PAD-US, 3DHP, Overture buildings —
# registry: shared/openData/corporaManifest.ts). Any S3-compatible
# object store works (Cloudflare R2, AWS S3, ...); ~$10–30/mo at
# full corpus scale per the open-data program research. UNSET =
# every corpus reports not_provisioned and nothing ingests. NOTE:
# no ingestion pipeline exists yet — setting these only moves
# status to storage_configured_pipeline_pending, never "ingested".
# OPEN_DATA_BUCKET_ENDPOINT=
# OPEN_DATA_BUCKET_NAME=
# OPEN_DATA_BUCKET_ACCESS_KEY_ID=
# OPEN_DATA_BUCKET_SECRET=
