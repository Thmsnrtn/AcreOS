# Staging realism-mode secrets — set on the staging Fly app with:
#   fly secrets set -a acreos-staging KEY=value KEY2=value2 …
# NEVER commit real values. These are the keys realism mode needs so the
# product's actual value paths run with REAL (test-mode) integrations.
# See tests/README-realism-mode.md.

# ── Core platform (required to boot — staging copies of prod) ──
DATABASE_URL=postgresql://…              # a SEPARATE staging Postgres (with pgvector)
SESSION_SECRET=…                         # 32+ chars
FIELD_ENCRYPTION_KEY=…                   # openssl rand -hex 32
CLERK_SECRET_KEY=sk_test_…               # a Clerk TEST instance (not prod)
CLERK_PUBLISHABLE_KEY=pk_test_…
VITE_CLERK_PUBLISHABLE_KEY=pk_test_…

# ── The value paths realism mode exists to verify (TEST/sandbox modes — no real
#    money, postage, SMS, or email sends) ──
REGRID_API_KEY=…                         # "find parcels" — the core land value prop
STRIPE_SECRET_KEY=sk_test_…              # payments + e-sign checkout
STRIPE_PUBLISHABLE_KEY=pk_test_…
LOB_API_KEY=test_…                       # direct mail — prints to the Lob dashboard, no postage
TWILIO_ACCOUNT_SID=…                     # SMS (use Twilio test credentials)
TWILIO_AUTH_TOKEN=…
TWILIO_PHONE_NUMBER=…
AWS_ACCESS_KEY_ID=…                      # email via SES (keep the account in sandbox)
AWS_SECRET_ACCESS_KEY=…
AWS_SES_FROM_EMAIL=…
AI_INTEGRATIONS_OPENROUTER_API_KEY=…     # Pax / deal-coach (a cheap model is fine)

# ── Leave background jobs ON for realism (do NOT set DISABLE_BACKGROUND_JOBS),
#    so async results — mail render, sequences, the Today brief — actually run.

# ── GitHub secrets (set with `gh secret set NAME`), NOT Fly secrets — used by
#    the realism-audit.yml workflow to drive the authed + DB layers:
#   CLERK_SIGN_IN_TICKET   — a one-time Clerk test sign-in ticket (mints a real session)
#   DATABASE_URL_STAGING   — read/write to the staging DB (for the IDOR + load seeders)
# And a repo VARIABLE (gh variable set):
#   FLY_STAGING_APP=acreos-staging
